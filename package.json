{
  "name": "@cosyte/dates",
  "version": "0.1.3",
  "description": "Date and time utilities for the @cosyte/* healthcare parsers: precision-preserving conversion and validation that never guesses a timezone.",
  "license": "MIT",
  "author": "Cosyte",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://docs.cosyte.com/dates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/dates.git"
  },
  "bugs": {
    "url": "https://github.com/cosyte/dates/issues"
  },
  "keywords": [
    "date",
    "datetime",
    "healthcare",
    "hl7",
    "fhir",
    "temporal",
    "iso-8601",
    "precision",
    "timezone",
    "validation",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "phi-scan": "cosyte-phi-scan",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:agent-notes": "cosyte-agent-notes",
    "check:catalog": "cosyte-catalog",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,md}\" \"docs-content/**/*.{md,json}\" \"*.{ts,json,md,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"examples/**/*.{ts,md}\" \"docs-content/**/*.{md,json}\" \"*.{ts,json,md,yml}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:tz": "TZ=UTC vitest run && TZ=Pacific/Kiritimati vitest run",
    "examples": "tsx scripts/run-examples.ts",
    "clean": "rm -rf dist coverage .tmp dist-artifacts",
    "attw": "cosyte-attw",
    "pack:docs": "bash scripts/build-docs-artifacts.sh",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "version": "changeset version && prettier --write package.json CHANGELOG.md",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw"
  },
  "dependencies": {
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.4",
    "@changesets/cli": "2.31.0",
    "@cosyte/eslint-config": "^0.1.2",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/script-utils": "^0.1.5",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.2",
    "@cosyte/vitest-config": "^0.1.2",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.12"
  },
  "prettier": "@cosyte/prettier-config"
}
