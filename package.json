{
  "name": "@cosyte/dates",
  "version": "0.1.5",
  "description": "Date and time utilities for the @cosyte/* healthcare parsers: precision-preserving conversion and validation that never guesses a timezone.",
  "license": "MIT",
  "author": "Cosyte",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://docs.cosyte.com/dates",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cosyte/dates.git"
  },
  "bugs": {
    "url": "https://github.com/cosyte/dates/issues"
  },
  "keywords": [
    "date",
    "datetime",
    "healthcare",
    "hl7",
    "fhir",
    "temporal",
    "iso-8601",
    "precision",
    "timezone",
    "validation",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "esbuild@>=0.27.3 <0.28.2": "0.28.2",
      "minimatch@>=10.0.0 <11.0.1": "11.0.1"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "cosyte-process build",
    "changeset": "changeset",
    "typecheck": "cosyte-process typecheck",
    "phi-scan": "cosyte-phi-scan",
    "check:readme": "cosyte-readme",
    "check:claude-card": "cosyte-claude-card",
    "check:catalog": "cosyte-catalog",
    "check:process": "cosyte-process check",
    "lint": "cosyte-process lint",
    "format": "cosyte-process format",
    "format:check": "cosyte-process format --check",
    "test": "cosyte-process test",
    "test:coverage": "cosyte-process test --coverage",
    "test:tz": "TZ=UTC cosyte-process test && TZ=Pacific/Kiritimati cosyte-process test",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "examples": "tsx scripts/run-examples.ts",
    "bench:reading": "cosyte-bench run --suite bench/dates.bench.mjs --target dist/index.js",
    "bench:compare": "cosyte-bench compare --suite bench/dates.bench.mjs",
    "bench:budgets": "node bench/budgets.mjs",
    "bench:profile": "node --enable-source-maps bench/profile.mjs dist/index.js",
    "clean": "rm -rf dist coverage .tmp dist-artifacts",
    "attw": "cosyte-attw",
    "pack:docs": "cosyte-process pack-docs",
    "check:no-emdash": "cosyte-no-emdash",
    "check:no-internal-refs": "cosyte-internal-refs",
    "version": "changeset version && cosyte-process format",
    "release": "changeset publish",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm attw"
  },
  "dependencies": {
    "temporal-polyfill": "1.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "2.31.0",
    "@cosyte/bench": "^0.1.1",
    "@cosyte/eslint-config": "^0.1.4",
    "@cosyte/prettier-config": "^0.1.2",
    "@cosyte/process": "^0.1.7",
    "@cosyte/script-utils": "^0.1.8",
    "@cosyte/test-utils": "^0.1.4",
    "@cosyte/tsconfig": "^0.1.2",
    "@cosyte/tsup-config": "^0.1.3",
    "@cosyte/vitest-config": "^0.1.3",
    "@types/node": "22.20.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "prettier": "@cosyte/prettier-config"
}
