{
  "extends": "@cosyte/tsconfig/base.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "@cosyte/dates": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "examples", "scripts/**/*.ts", "tsup.config.ts", "vitest.config.ts"]
}
